{
    "edit_predictions": {
        "open_ai_compatible_api": {
            "model": "Qwen3.8-27B-MTPLX-4bit",
            "api_url": "https://tokmax.paral.no/v1/chat/completions"
        },
    },
    "auto_update_extensions": {
        "discord-presence": false
    },
    "terminal": {
        "font_size": 15.0,
    },
    "diff_view_style": "split",
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry",
        },
        "gemini": {
            "type": "registry",
        },
    },
    "cli_default_open_behavior": "new_window",
    "format_on_save": "off",
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "buffer_font_weight": 500.0,
    "ui_font_family": ".ZedSans",
    "tabs": {
        "close_position": "right",
    },
    "title_bar": {
        "show_onboarding_banner": false,
        "show_branch_status_icon": true,
        "show_menus": false,
    },
    "tab_bar": {
        "show": false,
    },
    "toolbar": {
        "quick_actions": false,
    },
    "project_panel": {
        "hide_hidden": false,
        "button": true,
        "dock": "right",
        "default_width": 400,
        "hide_root": true,
        "scrollbar": {
            "show": "never",
            "horizontal_scroll": false,
        },
        "indent_guides": {
            "show": "never",
        },
    },
    "agent": {
        "dock": "left",
        "commit_message_model": {
            "provider": "OMLX",
            "model": "Qwen3.8-27B-MTPLX-4bit",
        },
        "default_profile": "write",
        "default_model": {
            "effort": "low",
            "provider": "OMLX",
            "model": "Qwen3.8-27B-MTPLX-4bit",
            "enable_thinking": true,
        },
        "favorite_models": [
            {
                "provider": "OMLX",
                "model": "Qwen3.8-27B-MTPLX-4bit",
                "enable_thinking": true,
            },
        ],
        "model_parameters": [],
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "telemetry": {
        "diagnostics": true,
        "metrics": true,
    },
    "status_bar": {
        "experimental.show": false,
    },
    "scrollbar": {
        "show": "never",
        "axes": {
            "vertical": false,
        },
    },
    "buffer_font_fallbacks": ["monospace", "monospace", "Hack Nerd Font"],
    "base_keymap": "VSCode",
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Soft Charmed Icons",
    },
    "ui_font_size": 18,
    "buffer_font_size": 17.0,
    "theme": {
        "mode": "dark",
        "light": "Ayu Light",
        "dark": "Sky",
    },
    "buffer_font_family": ".ZedMono",
    "buffer_font_features": {
        "ligatures": true,
    },
    "tab_size": 4,
    "languages": {
        "TypeScript": {
            "tab_size": 4,
            "formatter": {
                "language_server": {
                    "name": "biome",
                },
            },
        },
        "TSX": {
            "tab_size": 4,
            "formatter": {
                "language_server": {
                    "name": "biome",
                },
            },
        },
        "JSON": {
            "tab_size": 4,
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        },
        "JSONC": {
            "tab_size": 4,
            "formatter": {
                "language_server": {
                    "name": "biome"
                }
            }
        }
    },
    "lsp": {
        "biome": {
            "settings": {
                "require_config_file": true,
            },
        },
    },
    "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
    },
    "file_scan_exclusions": ["**/.DS_Store", "**/node_modules", "**/.target"],
    "language_models": {
        "openai_compatible": {
            "OMLX": {
                "api_url": "https://tokmax.paral.no/v1",
                "available_models": [
                    {
                        "name": "Qwen3.8-27B-MTPLX-4bit",
                        "max_tokens": 128000,
                        "max_output_tokens": 32000,
                        "max_completion_tokens": 128000,
                        "reasoning_effort": "low",
                        "capabilities": {
                            "tools": true,
                            "images": true,
                            "parallel_tool_calls": true,
                            "prompt_cache_key": true,
                            "chat_completions": true,
                            "interleaved_reasoning": false,
                            "max_tokens_parameter": true
                        }
                    }
                ]
            }
        },
        "ollama": {
            "api_url": "https://tokmax.paral.no",
            "context_window": 128000,
        },
    },
}
